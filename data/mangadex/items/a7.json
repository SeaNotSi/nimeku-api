4T04:08:24+00:00","baked":false},{"id":"4bd00692-5675-4756-acb4-dfc21033b64c","number":"12","volume":"1","title":"The Girl With the Cute Clothes's Friend","lang":"en","pages":8,"createdAt":"2023-10-25T03:24:55+00:00","baked":false},{"id":"1d922280-7cfe-4b9b-942b-97c1ec1283a3","number":"11","volume":"1","title":"The Girl With the Cute Clothes's Return Gift","lang":"en","pages":9,"createdAt":"2023-10-18T02:27:15+00:00","baked":false},{"id":"53dc4303-e436-423c-becb-256cf3e4f33b","number":"11","volume":"1","title":"chapter 11","lang":"id","pages":12,"createdAt":"2025-07-04T03:36:07+00:00","baked":false},{"id":"0eb1490b-81a9-4c09-9c66-d46feb2cd927","number":"10","volume":"1","title":"The Girl With the Cute Clothes's Fun Time","lang":"en","pages":8,"createdAt":"2023-10-11T03:43:58+00:00","baked":false}],"chapterCount":64,"chaptersAt":"2026-10-26T19:06:33.291Z"},"664e8181-7b5e-4225-abcb-9e01f34b76a3":{"id":"664e8181-7b5e-4225-abcb-9e01f34b76a3","title":"The Killer Whale's Comfort Penguin","altTitle":"The Crazy Orca's Favourite Penguin","description":"Lia, a penguin-turned-human, hides her anthropomorphic self from her dad for fear of abandonment and hatred. Fleeing her home, she’s discovered by Souradel—a killer whale anthro with a thing for penguins. His obsession with her fluffy belly leads to wild misunderstandings, mistaken kisses, and hilariously tense encounters. Now, Lia must dodge his affections while keeping her identity secret.\n___\nBorn as a penguin, I miraculously transformed into a human. The problem? My guardian, the Tower Master, hates beastmen. Fearing discovery, I ran away, only to be found out by a self-proclaimed penguin enthusiast.\n\nWhale clan orca beastman, Suuradel, looked at me intensely, his eyes reddening sensually.\n\n“Ha… Your wild eyes are incredible.”\n\nThose aren’t eyes, just white feathers.\n\n“May I touch your belly fat?”\n\nSeriously? Furious, I pecked at him, but he looked oddly elated.\n\n“Did you just kiss me?”\n\n…It seems I got caught by a lunatic, not a penguin enthusiast.","year":2024,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Romance","Fantasy"],"poster":"https://uploads.mangadex.org/covers/664e8181-7b5e-4225-abcb-9e01f34b76a3/95421b58-a98c-440b-9e64-00d29925da29.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["pt-br","en"],"lane":"manhwa","rating":8.69,"follows":1653,"listAt":"2026-10-27T12:21:17.674Z","chapters":[{"id":"c942453d-4c8c-4dec-acbf-cc84108ab8b8","number":"9","volume":null,"title":null,"lang":"en","pages":16,"createdAt":"2024-10-02T17:54:40+00:00","baked":false},{"id":"6e5a5894-dadd-4e6f-b3c6-28b946c0be0a","number":"8","volume":null,"title":null,"lang":"en","pages":14,"createdAt":"2024-10-02T17:53:41+00:00","baked":false},{"id":"76b8c4ac-8499-4ec7-9870-1e3f9818bf78","number":"7","volume":null,"title":null,"lang":"en","pages":15,"createdAt":"2024-09-07T18:43:53+00:00","baked":false},{"id":"69c2214a-ec80-4ca3-9d86-e49733f855a4","number":"6","volume":null,"title":null,"lang":"en","pages":15,"createdAt":"2024-09-01T01:08:08+00:00","baked":false},{"id":"ce234644-962c-45d4-b1df-62b702b0776d","number":"5","volume":null,"title":null,"lang":"en","pages":16,"createdAt":"2024-09-01T01:06:41+00:00","baked":false},{"id":"a88f6b68-cc31-45dc-85b2-eb927897bf41","number":"4","volume":null,"title":null,"lang":"en","pages":15,"createdAt":"2024-08-23T05:52:01+00:00","baked":false},{"id":"746b4452-69d9-48e3-a423-e676a4edbb90","number":"3","volume":null,"title":null,"lang":"en","pages":16,"createdAt":"2024-08-15T03:14:37+00:00","baked":false},{"id":"9f7cbd2e-e26e-4ced-806e-7b618ec49dd6","number":"2","volume":null,"title":null,"lang":"en","pages":19,"createdAt":"2024-08-07T23:30:47+00:00","baked":false},{"id":"485c33de-f2b5-494a-a12d-fbc89240f030","number":"1","volume":null,"title":null,"lang":"en","pages":20,"createdAt":"2024-08-03T10:38:36+00:00","baked":false}],"chapterCount":9,"chaptersAt":"2026-10-26T19:09:17.674Z"},"cf542fc4-8e03-4903-a0f0-2dd5d72da474":{"id":"cf542fc4-8e03-4903-a0f0-2dd5d72da474","title":"Ryuuzaki-san ga Ore no Mae dake de Dereru Riyuu","altTitle":"The Reasons Why Ryuuzaki-san Only Shows Her Sweet Side to Me","description":"Ryuuzaki-san, yang dikenal sebagai gadis tercantik di angkatan kami, entah kenapa bersikap sangat dingin kepadaku. Setiap kali mata kami bertemu, dia selalu menatapku dengan tajam seolah-olah sedang melihat sampah.\n\nHingga pada suatu hari, aku tidak sengaja melihat wujud asli Ryuuzaki-san yang luar biasa...ternyata dia bukanlah manusia, melainkan seorang \"Dragonkin\" (Manusia Naga).\n\n\"T-Tolong jangan menatapku seperti itu!\"\n\nWajah asli yang hanya diperlihatkan oleh sang primadona sekolah itu kepadaku ternyata sangat manja dan pemalu di luar dugaan, hingga membuatku benar-benar goyah!?\n\nKisah komedi romantis di dunia nyata dengan sedikit sentuhan fantasi, resmi dimulai.","year":2025,"status":"ongoing","lastChapter":null,"contentRating":"suggestive","tags":["Romance","Comedy","Fantasy","Slice of Life"],"poster":"https://uploads.mangadex.org/covers/cf542fc4-8e03-4903-a0f0-2dd5d72da474/e9a209d2-be35-4762-a035-180307c1f1f4.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["en","vi","id"],"lane":"manga","rating":7.5,"follows":4475,"listAt":"2026-10-25T00:58:11.810Z","chapters":[{"id":"171fa033-f982-4189-a2c5-f13bb29a5621","number":"11","volume":"3","title":"Become My Lover","lang":"en","pages":28,"createdAt":"2026-10-19T10:58:40+00:00","baked":false},{"id":"cf96273d-c9e8-4555-ae62-17ac1cea4536","number":"11","volume":"3","title":"Jadilah Kekasihku","lang":"id","pages":28,"createdAt":"2026-10-19T10:58:07+00:00","baked":false},{"id":"ee414e18-66be-456b-b79d-ee9b8f68dc9f","number":"10.5","volume":"2","title":"Volume 2 Bonus Chapter","lang":"en","pages":9,"createdAt":"2026-10-19T10:57:28+00:00","baked":false},{"id":"d4d37ca0-ab2b-412b-923a-5482ebc1a79e","number":"10.5","volume":"2","title":"Chapter Bonus Volume 2","lang":"id","pages":9,"createdAt":"2026-10-19T10:53:27+0