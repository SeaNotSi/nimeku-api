rth, standing unrivaled against all formidable opponents.","year":2024,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Action","Adventure","Isekai","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/d31ea090-516f-4227-aa77-71e9933074bc/16810a9e-368b-4128-84e6-7824835ef2b6.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["fr","id"],"lane":"manga","rating":4.29,"follows":840,"listAt":"2026-10-22T07:10:11.511Z","chapters":[{"id":"37ca0731-43a2-4e6e-b61d-c12c3560144a","number":"2","volume":null,"title":null,"lang":"id","pages":33,"createdAt":"2025-05-03T14:03:39+00:00","baked":false},{"id":"82046890-f649-4be3-8363-27cd35907776","number":"1","volume":null,"title":null,"lang":"id","pages":75,"createdAt":"2025-05-03T13:54:20+00:00","baked":false}],"chapterCount":2,"chaptersAt":"2026-10-22T01:05:29.235Z"}}
