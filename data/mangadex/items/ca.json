{"2de02096-96d1-434d-9b0f-273fcb3a8b5a":{"id":"2de02096-96d1-434d-9b0f-273fcb3a8b5a","title":"Hito no Kokoro ga Yomeru Kanojo no Hanashi","altTitle":"The Story of a Girl Who Can Read Minds","description":"Born with the ability to read other people's minds, Fukami Kokoro has grown sick of the gap between people's true feelings and the fronts they put up, leaving her unable to trust anyone. Then she encounters a man who has nothing but ulterior motives, whose thoughts and feelings were completely straightforward?! As she is thrown about by his completely unfiltered thoughts, Kokoro experiences for the first time the sense of security that comes from knowing there are no lies, and little by little, begins to open her heart.","year":2026,"status":"ongoing","lastChapter":null,"contentRating":"suggestive","tags":["Romance","Comedy"],"poster":"https://uploads.mangadex.org/covers/2de02096-96d1-434d-9b0f-273fcb3a8b5a/ebf32ec6-85f0-48eb-b305-bf1a766b4b0c.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["id","vi","es-la","en","fr"],"lane":"manga","rating":7.78,"follows":25995,"listAt":"2026-10-31T12:41:46.473Z","chapters":[{"id":"bfe9173b-9cc7-49ba-ad96-e945f188e4b2","number":"10","volume":null,"title":"Mabok-maboan","lang":"id","pages":9,"createdAt":"2026-10-16T23:08:59+00:00","baked":true},{"id":"1c6b436d-66d2-4903-aeb8-3e5e5d89f83c","number":"10","volume":null,"title":"The Story of the Last Train","lang":"en","pages":9,"createdAt":"2026-10-15T15:05:04+00:00","baked":true},{"id":"24d44bcb-38ee-4fd0-a364-3014dff77370","number":"9","volume":null,"title":"The Story of Ramen","lang":"en","pages":8,"createdAt":"2026-10-12T14:35:40+00:00","baked":true},{"id":"34bed7eb-e4bf-4418-a396-0420a348bd22","number":"9","volume":null,"title":"Indomie Rasa Bawang Putih😋","lang":"id","pages":9,"createdAt":"2026-10-15T13:49:24+00:00","baked":true},{"id":"c9bbee81-dbae-4129-809b-c1c3bafe44b9","number":"8","volume":null,"title":"Panas woy!","lang":"id","pages":10,"createdAt":"2026-10-03