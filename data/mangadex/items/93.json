56+00:00","baked":false},{"id":"fce63490-fe7d-43a5-8315-b622f3881a60","number":"2","volume":"1","title":null,"lang":"en","pages":36,"createdAt":"2021-03-10T17:33:13+00:00","baked":false}],"chapterCount":41,"chaptersAt":"2026-10-19T10:31:07.713Z"},"1464b26f-c5bb-4d19-9fa2-42f78ce01fcb":{"id":"1464b26f-c5bb-4d19-9fa2-42f78ce01fcb","title":"Tokubetsu dakara Ii no kana?","altTitle":"Is It Okay Because You're Special?","description":"Sequel doujin to [Ao to Shiro to Natsufuku](https://mangadex.org/title/1ddbf2da-fbbd-4680-bc08-0dd857fe99fb/ao-to-shiro-to-natsufuku) created by [Izumi Kirifu](https://x.com/kirifu0127) released in Rainbow Flavor 36.","year":2026,"status":"completed","lastChapter":null,"contentRating":"safe","tags":["Romance","Magical Girls","Girls' Love"],"poster":"https://uploads.mangadex.org/covers/1464b26f-c5bb-4d19-9fa2-42f78ce01fcb/fe9df260-7142-40df-92c6-3bab2d336dda.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["en"],"lane":"manga","rating":8.22,"follows":285,"listAt":"2026-10-22T13:05:48.541Z","chapters":[{"id":"5131b3d1-0087-479c-8971-b65dc3c40ada","number":null,"volume":null,"title":null,"lang":"en","pages":23,"createdAt":"2026-10-16T16:52:32+00:00","baked":false}],"chapterCount":1,"chaptersAt":"2026-10-19T10:32:12.368Z"},"c326248a-0412-4ab8-9e0f-72b06feb70d2":{"id":"c326248a-0412-4ab8-9e0f-72b06feb70d2","title":"Akdang Nampyeongwa Ihonharyeoneunde, Aiga Saenggyeotda","altTitle":"I Plan to Divorce My Villain Husband, but We Have a Child","description":"I already possess the body of a woman who will marry the devil. In a role haunted by her husband until death.\n\n\"I will always be by your side!\"\n\nI've decided to be nice to this poor husband for a while. But before one day, when I had reached adulthood and planned to divorce. A little angel appeared in the night full of surprises. Oh, man. So I tried to run away before being discovered…\n\n\"Richard? Something's not right…\"\n\n\"I have no intention of letting you run away, even if you die, you must stay in my arms. Elisha.\"\n\nTrying to cry and beg with a pretty face is also not possible.\n\n\"Where are you going to take our child?\"\n\nDid he even chase after me with those cold eyes? …I guess I was wrong to run away like this. How to solve this situation?\n\n---\nAfter losing her parents at an early age, noble lady Elissa Lohengrin is brought into the powerful House Rubelin by the duke so that she can marry his grandson, Richard. However, having read this story in her past life, Elissa knows Richard is destined to murder her! To avoid this, Elissa makes a deal with Richard to divorce when they become adults. But as she plans for her future single life, Richard's feelings begin to grow, and a whirlwind of events begins that pulls Elissa closer to danger.","year":2022,"status":"completed","lastChapter":"110","contentRating":"safe","tags":["Historical","Romance","Isekai","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/c326248a-0412-4ab8-9e0f-72b06feb70d2/8f147b79-79d8-4c25-910b-80e0bb704bfb.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["es-la","en","pl"],"lane":"manhwa","rating":7.71,"follows":2284,"listAt":"2026-10-26T07:10:54.138Z","chapters":[{"id":"692f3ca0-3061-4322-acd6-7d1dd66c485e","number":"1","volume":null,"title":null,"lang":"en","pages":55,"createdAt":"2022-10-08T12:09:35+00:00","baked":false}],"chapterCount":1,"chaptersAt":"2026-10-19T10:30:06.114Z"},"196e48dd-7e08-4fed-ae66-f07f7c634c30":{"id":"196e48dd-7e08-4fed-ae66-f07f7c634c30","title":"Outo no Hazure no Renkinjutsushi ~Hazure Shokugyou Datta node, Nonbiri Omise Keiei Shimasu~","altTitle":"A Tale of a Little Alchemist Blessed by the Spirits","description":"Daisy von Preslaria, born in a viscount family that produces excellent magicians, was the only one in the family that was granted the failure job, Alchemist. Since this has happened, she's going to try studying hard and becoming independent as a worthy alchemist! The five-year-old girl so resolved and began to make potions by trial and error. Thanks to the Appraisal skill that she secretly possessed, let alone failures, her finished products were of such high quality never seen anywhere! She cultivated medicinal herbs, indulged herself in research, went harvesting, and opened a store.","year":2021,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Adventure","Fantasy","Slice of Life"],"poster":"https://uploads.mangadex.org/covers/196e48dd-7e08-4fed-ae66-f07f7c634c30/30aa0b27-d3a0-4239-ad6a-1e52aac109a4.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["en","vi"],"lane":"manga","rating":8.06,"follows":14007,"listAt":"2026-10-26T07:09:53.586Z","chapters":[{"id":"2a90a0aa-e3cb-48d8-9fed-eb6d9e251009","number":"43","volume":"6","title":"Creating Alchemist's Equipment (Part 1)","lang":"en","pages":19,"createdAt":"2026-10-24T15:55:28+00:00","baked":false},{"id":"ce4fe6d4-c720-4432-a125-58ee8dbb5148","number":"42","volume":"6","title":"Running An Alchemist's Atelier","lang":"en","pages":23,"createdAt":"2026-09-20T12:21:29+00:00","baked":false},{"id":"31d11406-6e72-4933-a651-b2d08d567b81","number":"41","volume":"6","title":"Demon Summoning","lang":"en","pages":19,"createdAt":"2026-08-18T15:53:09+00:00","baked":false},{"id":"9e29dbf4-84fe-4989-b192-d4e3fcc7540b","number":"40","volume":"6","title":"The Trials Of The Older Siblings","lang":"en","pages":22,"createdAt":"2026-07-28T17:26:19+00:00","baked":false},{"id":"1651dd30-9381-48c7-ac52-dacc7d610a47","number":"39","volume":"6","title":"I'm Home!","lang":"en","pages":18,"createdAt":"2026-07-07T16:58:04+00:00","baked":false},{"id":"b743c94c-35fd-48cd-8f4e-0fc442736fa1","number":"38","volume":"6","title":"The Elven Princess And The Mossy Healing Cave","lang":"en","pages":19,"createdAt":"2026-06-17T18:52:00+00:00","baked":false},{"id":"4b6c8ef4-32d2-44b7-84d7-c77aae4973b6","number":"37","volume":"6","title":"The Elven Village And The World Tree (Part 2)","lang":"en","pages":22,"createdAt"