)","lang":"id","pages":20,"createdAt":"2024-12-17T20:54:29+00:00","baked":false},{"id":"8d8b49e9-5c34-4e50-b0da-2a62f26528a8","number":"1","volume":"1","title":"Awal Dari Para Pria","lang":"id","pages":27,"createdAt":"2024-10-12T12:46:11+00:00","baked":false},{"id":"f2ea716d-b9ee-4342-a0b1-82b34479cd2b","number":null,"volume":null,"title":null,"lang":"en","pages":13,"createdAt":"2025-07-16T14:32:55+00:00","baked":false}],"chapterCount":4,"chaptersAt":"2026-10-19T10:32:29.232Z"}}
