2","volume":"2","title":"Menginap bersamaku!","lang":"id","pages":29,"createdAt":"2025-08-02T00:22:44+00:00","baked":false},{"id":"9e830c2d-3a5e-47b0-bdc4-974aaa8d94bb","number":"11","volume":"2","title":"Me and My Resolve","lang":"en","pages":31,"createdAt":"2025-09-27T16:28:50+00:00","baked":false},{"id":"f5ecd73c-07ac-4cac-9023-2908f6db8a84","number":"11","volume":"2","title":"Aku dan keseriusanku!","lang":"id","pages":31,"createdAt":"2025-08-02T00:21:04+00:00","baked":false},{"id":"bcbae8b1-f1e0-432e-9bc4-0d8e1931c023","number":"10","volume":"2","title":"A Date With Me","lang":"en","pages":26,"createdAt":"2025-05-14T11:07:26+00:00","baked":false}],"chapterCount":33,"chaptersAt":"2026-10-19T10:28:44.690Z"},"09deb52a-4546-432d-b7ad-ef72e417f814":{"id":"09deb52a-4546-432d-b7ad-ef72e417f814","title":"Magye Academy-ui Silnun Agyeok","altTitle":"The Narrow-Eyed Villain of the Demon Academy","description":"The very last moment before the novel was about the end, the strongest villain met a pitiful fate.\n\nBut that wasn't the end.\n\n\"So, this is how I die.\"\n\nI, who was once the author, woke up as the fox-eyed villian who was never once understood.\n\nA fallen family. A life thrown away for revenge. A future sealed in tragedy.\n\nI'm going to rewrite it all.\n\nThis villain's end... will be reversed.","year":2025,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Action","Adventure","Isekai","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/09deb52a-4546-432d-b7ad-ef72e417f814/373250af-6a22-4c94-973e-bd11dc977e6f.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["en"],"lane":"manhwa","rating":8.47,"follows":3225,"listAt":"2026-10-23T04:02:52.427Z","chapters":[{"id":"86029d9d-e066-4903-8706-e9dcac8985ad","number":"41","volume":null,"title":null,"lang":"en","pages":16,"createdAt":"2025-09-06T21:52:45+00:00","baked":false}],"chapterCount":1,"chaptersAt":"2026-10-19T10:29:52.973Z"},"8dcdcee1-717d-4601-b828-4035ff247b31":{"id":"8dcdcee1-717d-4601-b828-4035ff247b31","title":"Mimicry Girls","altTitle":"ミミクリー・ガールズ","description":"The year is 2041. It has been several years since the development of Artificial Body technology, commonly known as \"Mimic.\" Captain Chris Armstrong, after suffering a serious injury from an unexpected incident during a military operation, undergoes mimic surgery and returns to the frontlines... or at least, that was the plan. After the surgery, there was something strange about his body. His reflection that he saw in the mirror had soft white skin, complimented by silky hair——it was a beautiful girl!?!!?\n\nAmidst the flames of war writhing with conspiracy and resentment, a makeshift team of four girl-type mimics was formed. Their name: Mimicry Girls.\n\nShooting, CQC, infiltration. A mission was given to these girls that were specialists in all fields. That is, to escort the president's daughter from the international criminal organization \"Val Verde\" that is out for her life. After a cool tea party is the start of a cute operation! Taking on the form of girls, they face off against the world's greatest evils!","year":2022,"status":"completed","lastChapter":"37","contentRating":"safe","tags":["Sci-Fi","Action","Comedy","Mecha"],"poster":"https://uploads.mangadex.org/covers/8dcdcee1-717d-4601-b828-4035ff247b31/a726415f-a180-47a2-a51e-0fb5c4ceec39.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["zh","vi","en","id","es-la"],"lane":"manga","rating":8.39,"follows":4750,"listAt":"2026-10-23T04:02:06.768Z","chapters":[{"id":"686e63d3-62b5-45d0-82af-cdbc8dfcf2c0","number":"13","volume":"2","title":null,"lang":"en","pages":19,"createdAt":"2025-05-12T13:00:07+00:00","baked":false},{"id":"31becba4-201d-408b-8925-95425e131391","number":"12","volume":"2","title":null,"lang":"en","pages":16,"createdAt":"2025-05-12T11:07:59+00:00","baked":false},{"id":"77c9c700-96eb-46c4-99bc-1cf1987ea4b6","number":"11","volume":"2","title":null,"lang":"en","pages":20,"createdAt":"