 Buddy","altTitle":"엔젤 버디","description":"Upon catching a baby bird that stole his wallet, an angel suddenly fell from the sky! This is the sweet and mysterious romance of the lonesome Suho, and the angel called Taker who said it was Suho's fault his wings got injured, and he would stay with him so he could take responsibility for it.  \n  \n\n\n---","year":null,"status":"completed","lastChapter":"82","contentRating":"safe","tags":["Romance","Boys' Love","Drama","Fantasy","Mystery"],"poster":"https://uploads.mangadex.org/covers/b6afbe38-6574-44b7-a299-e50188dd7a42/846f99bc-03c1-45b0-9953-5a2a33899cb1.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["es-la","pt-br","en"],"lane":"manhwa","rating":9.02,"follows":7779,"listAt":"2026-10-30T22:27:23.412Z","chapters":[{"id":"1293e623-3bde-4ff9-ba50-b47860055967","number":"20","volume":null,"title":null,"lang":"en","pages":40,"createdAt":"2020-03-01T04:28:16+00:00","baked":false},{"id":"37082e13-4cae-4647-b879-13b32f6e722a","number":"19","volume":null,"title":null,"lang":"en","pages":46,"createdAt":"2020-03-01T04:18:35+00:00","baked":false},{"id":"8fbbc131-ca04-4323-ac3a-de8b322ccbff","number":"18","volume":null,"title":null,"lang":"en","pages":40,"createdAt":"2020-03-01T04:14:15+00:00","baked":false},{"id":"e018af40-1b3d-4ba7-ad1d-1e47f4df2284","number":"17","volume":null,"title":null,"lang":"en","pages":43,"createdAt":"2020-03-01T04:02:58+00:00","baked":false},{"id":"92d20c2c-63c4-48af-b090-357e39dbb6b4","number":"16","volume":null,"title":null,"lang":"en","pages":46,"createdAt":"2020-03-01T04:00:32+00:00","baked":false},{"id":"db4a17a3-90f2-48a3-bca4-7771fedd5bb2","number":"15","volume":null,"title":null,"lang":"en","pages":46,"createdAt":"2020-02-26T03:27:48+00:00","baked":false},{"id":"5f116de8-68e2-419d-99c0-efe14f6a66bf","number":"14","volume":null,"title":null,"lang":"en","pages":42,"createdAt":"2020-02-26T03:22:34+00:00","baked":false},{"id":"a13608dc-cb4c-4c01-8598-6d9c4fecb5b4","number":"13","volume":nu