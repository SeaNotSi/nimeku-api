{"d90ea6cb-7bc3-4d80-8af0-28557e6c4e17":{"id":"d90ea6cb-7bc3-4d80-8af0-28557e6c4e17","title":"Dungeon Meshi","altTitle":"Dungeon Meals","description":"Seorang penjelajah muda, Laios, bersama kawan-kawannya mendapat serangan hebat dari seekor naga jauh di lantai terdalam Dungeon. Mereka kehilangan seluruh uang dan perbekalan, bahkan seorang anggota tim! Walau ingin bergegas kembali dan menyelamatkan rekannya, mereka dihalangi satu masalah besar, “Tanpa makanan dan uang, mereka pasti akan kelaparan di tengah penjelajahan!” Namun, Laios mendapat ide cemerlang, “Kita makan monster saja!”. Slime, kalajengking, basilisk, mandrake, dan kelelawar raksasa… Tidak ada satu monster pun yang luput dari perut-perut keroncongan di Dungeon!! (Gramedia.com) \n\n[Terjemah Indonesia](https://www.gramedia.com/search?q=delicious%20in%20dungeon)","year":2014,"status":"completed","lastChapter":"97","contentRating":"safe","tags":["Action","Comedy","Adventure","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/d90ea6cb-7bc3-4d80-8af0-28557e6c4e17/d3430039-ea47-48c3-9b8b-cf80200d7f0b.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["ru","es","uk","vi","en","es-la","pt-br","id","ar"],"lane":"manga","rating":9.6,"follows":122371,"listAt":"2026-10-19T10:05:14.339Z","chapters":[{"id":"cdc5118e-3b64-4d5c-9981-dd4252c5dfc2","number":"5","volume":"1","title":"Kakiage","lang":"id","pages":24,"createdAt":"2025-05-10T15:20:12+00:00","baked":true},{"id":"a34e51e9-08a3-4b10-b8d9-8774ccbbefda","number":"4","volume":"1","title":"Omelette","lang":"id","pages":24,"createdAt":"2025-05-08T16:06:11+00:00","baked":true},{"id":"9d0de89a-659d-4aa7-8602-6a7241db8e0d","number":"3","volume":"1","title":"Basilisk Panggang","lang":"id","pages":24,"createdAt":"2025-05-08T16:14:55+00:00","baked":true},{"id":"594f9df2-4a38-42f8-a5e6-5affe17ff5b5","number":"2","volume":"1","title":"Tart","lang":"id","pages":24,"createdAt":"2025-05-08T16:20:43+00:00","baked":true}],"chapterCount":4,"chaptersAt":"202