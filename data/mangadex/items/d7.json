ana kekaisaran. Di sana, ia menyadari bahwa tetangganya yang ramah ternyata adalah sang tiran yang ditakuti. Sang tiran kemudian mendeklarasikannya sebagai calon menantunya dengan bermodalkan sebuah coretan masa kecil sebagai kontrak pernikahan. Seiring dengan terungkapnya kebenaran tentang mendiang ayahnya dan garis keturunannya yang tersembunyi, ia mulai menyadari bahwa dirinya mungkin bukanlah sekadar karakter figuran biasa.","year":2026,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Romance","Isekai","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/2587e0be-184f-4061-8137-5d99cc40bea8/ebe0931c-1647-4811-831a-ea7bc86f04f2.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["id"],"lane":"manhwa","rating":null,"follows":91,"listAt":"2026-10-23T01:08:00.376Z","chapters":[{"id":"7535f3bf-9db6-417d-b789-0933c73b2098","number":"1","volume":null,"title":null,"lang":"id","pages":20,"createdAt":"2026-08-05T15:51:29+00:00","baked":false},{"id":"cdf1f830-0ca3-4cee-b966-7b7b405cad82","number":"0","volume":null,"title":"Prolog","lang":"id","pages":8,"createdAt":"2026-08-01T16:37:30+00:00","baked":false}],"chapterCount":2,"chaptersAt":"2026-10-19T10:32:28.285Z"},"465cd757-520b-4733-90c8-eadf8e0cb19c":{"id":"465cd757-520b-4733-90c8-eadf8e0cb19c","title":"Doggo Wife & Househusband","altTitle":null,"description":null,"year":2021,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Romance"],"poster":"https://uploads.mangadex.org/covers/465cd757-520b-4733-90c8-eadf8e0cb19c/9db31c95-0934-4bf3-a93a-d7893bc58f33.png.512.jpg","originalLanguage":"ko","availableLanguages":["tr","vi","en"],"lane":"manhwa","rating":8.5,"follows":3146,"listAt":"2026-10-23T01:08:13.612Z","chapters":[{"id":"46fd91bc-6ad0-4191-95d5-aac2d8774c58","number":"2","volume":null,"title":"For rent","lang":"en","pages":9,"createdAt":"2024-10-28T04:29:54+00:00","baked":false},{"id":"ccced73f-4c37-486c-99c7-c6f616d088d7","number":"1","volume":null,"title":nu