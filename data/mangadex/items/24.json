on, changes her name to Haruhi, returns to the Todou family, and begins to take revenge for the death of her murdered mother.","year":2023,"status":"completed","lastChapter":"30","contentRating":"safe","tags":["Historical","Drama"],"poster":"https://uploads.mangadex.org/covers/b8cd7c51-3eec-483e-bb56-6891c5b11d1d/5dd72d8c-af86-4f73-8393-d423ce0a38fa.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["en"],"lane":"manga","rating":6.78,"follows":1078,"listAt":"2026-10-22T01:04:02.231Z","chapters":[{"id":"98d33eab-56ed-4266-bd6f-0f3153eada55","number":"11","volume":"2","title":null,"lang":"en","pages":25,"createdAt":"2026-10-16T12:16:23+00:00","baked":false},{"id":"055e3a79-6faa-4ef5-bd96-77b5e237f721","number":"10","volume":"2","title":null,"lang":"en","pages":27,"createdAt":"2026-09-18T12:03:09+00:00","baked":false},{"id":"be2bca9c-5142-4e34-a23b-fb18648951f7","number":"9","volume":"2","title":null,"lang":"en","pages":27,"createdAt":"2026-07-10T12:36:56+00:00","baked":false},{"id":"ad748ab8-9d14-44cf-a71f-7edcdee4104d","number":"8","volume":"2","title":null,"lang":"en","pages":27,"createdAt":"2026-04-10T13:28:53+00:00","baked":false},{"id":"48e3c18e-3e43-49f2-a1d7-7b48940cc6c0","number":"7","volume":"2","title":null,"lang":"en","pages":31,"createdAt":"2026-03-27T13:58:45+00:00","baked":false},{"id":"3952a1d8-feb6-4781-b38c-b420994f6825","number":"6","volume":"1","title":null,"lang":"en","pages":26,"createdAt":"2026-02-27T12:05:46+00:00","baked":false},{"id":"b89601bb-abe7-4422-89fb-85039ca5a4c6","number":"5","volume":"1","title":null,"lang":"en","pages":27,"createdAt":"2026-02-20T13:06:01+00:00","baked":false},{"id":"925d0a38-43cd-4bfd-8a9a-776f492908e2","number":"4","volume":"1","title":null,"lang":"en","pages":25,"createdAt":"2025-12-12T12:52:32+00:00","baked":false},{"id":"9fc9bd41-e5b6-436a-9fdf-6ad669cfce78","number":"3","volume":"1","title":null,"lang":"en","pages":25,"createdAt":"2025-10-31T14:13:40+00:00","baked":false},{"id":"db1c807e-fa9e-430c-b497-