":["Sports","Slice of Life"],"poster":"https://uploads.mangadex.org/covers/39cb26c6-184f-442d-9415-6a42fcbd44c0/66cc3d55-65b2-4ce2-8874-ee2279df408c.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["en"],"lane":"manga","rating":9,"follows":207,"listAt":"2026-10-27T05:12:40.574Z","chapters":[{"id":"9115fcba-ad6f-4fa1-be25-818cd90e512c","number":"4","volume":"1","title":"Losing Weight with Judo","lang":"en","pages":24,"createdAt":"2026-10-23T05:04:21+00:00","baked":false},{"id":"01951321-de2b-4d25-9cc1-edb8dc766ce7","number":"3","volume":"1","title":"Under 61kg, Strong, and With Free Time to Spare","lang":"en","pages":20,"createdAt":"2026-01-23T21:57:56+00:00","baked":false},{"id":"e1fd404e-3494-4d97-a2ff-abd31e688432","number":"2","volume":"1","title":"Hellish Ball Pick Up","lang":"en","pages":24,"createdAt":"2026-01-23T21:44:43+00:00","baked":false},{"id":"91502bac-f6f8-4562-9c31-63fd60b43ae2","number":"1","volume":"1","title":"The First 11 Seconds","lang":"en","pages":37,"createdAt":"2026-01-23T17:36:55+00:00","baked":false}],"chapterCount":4,"chaptersAt":"2026-10-23T07:01:29.346Z"},"95d28a64-7e13-4ed4-b686-a013abd879ed":{"id":"95d28a64-7e13-4ed4-b686-a013abd879ed","title":"Fujisan Daifunka ~Senryokugai Nintei Sareta Ossan Kaishain Mochizane ga Tenpenchii de Nariagari!?~","altTitle":"Mount Fuji Eruption: Mochizane, an Old Office Worker Who was Removed from the Team, Rises to Power in a Natural Disaster!?","description":"\"The world might as well just turn upside down,\" thinks Motizane, a salaryman who despite his earnest dedication to his job, spends his days being belittled by juniors from other departments and struggling to keep up with an endless mountain of work. In the midst of these exhausting days, Motizane makes a mistake at work and is forced to head to Gotenba City at the foot of Mount Fuji with his boss. Just as he reaches his breaking point and decides to quit his company, something unthinkable happens...! Yuu Sakado, the creator known for \"