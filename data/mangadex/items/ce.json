6:09+00:00","baked":true},{"id":"f62529e3-649b-4bb9-9893-09dbd208ba83","number":"1","volume":"1","title":"Aku memperbaiki sepeda gyaru ","lang":"id","pages":50,"createdAt":"2025-12-08T09:36:39+00:00","baked":true},{"id":"141c296a-7172-4f86-9b56-b68ce5d52522","number":"1","volume":"1","title":"I Repaired a Gal’s Bicycle","lang":"en","pages":48,"createdAt":"2026-02-15T00:20:12+00:00","baked":true}],"chapterCount":29,"chaptersAt":"2026-10-26T18:47:26.244Z"},"590ce306-df89-4cec-94c3-886d01422174":{"id":"590ce306-df89-4cec-94c3-886d01422174","title":"Angel or Villainess","altTitle":"Angelic Lady","description":"Angela was my friend. I wanted to give anything to her, who I thought more precious than my own family. And I eventually turned Angela, a lowly aristocrat from the countryside, into the flower of the capital society. But it was betrayal that came back. She sold me and my family to become an imperial princess.\n\n\"…Did you have to go this far?\"\n\"Because I wanted you to be unhappy. I wanted to take your whole life away.\"\n\nBut when I thought I had died under the guillotine, I was surprisingly back in the past.\n\n\"Oh, hello. My name is Angela Vito…\"\n\"You're Angela! Nice to meet you. Everyone was waiting for you.\"\n\nWith a bright smile, I held her hands together again.\n\n---\nMy best friend betrayed me! Born from a low-ranking noble family, Angela grew to be renowned for her beauty and grace, becoming the prized angel of society, all with my enthusiastic support. Yet beneath that glitz and polish, she was simply... evil. She used me and had me killed out of sheer spite in her quest to become the empire’s greatest woman. But unlucky for her, a magical gift from a dragon has given me a second chance at life. No longer blinded by her light, I’ll do all I can to stop her!","year":2020,"status":"completed","lastChapter":"172","contentRating":"safe","tags":["Romance","Drama","Fantasy","Tragedy"],"poster":"https://uploads.mangadex.org/covers/590ce306-df89-4cec-94c3-886d01422174/2e8ddecd-1762-496a-b99c-84caf626766d.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["en","fr","my"],"lane":"manhwa","rating":7.96,"follows":25612,"listAt":"2026-10-19T10:05:23.768Z","chapters":[{"id":"75386aed-c85f-4fb9-8ba8-aa625a55b6a6","number":"44","volume":null,"title":null,"lang":"en","pages":10,"createdAt":"2021-09-11T12:12:46+00:00","baked":false},{"id":"5f5f0454-adc9-4fa6-b36a-55d2e6856d43","number":"43","volume":null,"title":null,"lang":"en","pages":12,"createdAt":"2021-09-11T12:12:02+00:00","baked":false},{"id":"45e97bf7-effe-4f0f-90bf-b4fdc768675c","number":"42","volume":null,"title":null,"lang":"en","pages":11,"createdAt":"2021-09-11T12:10:49+00:00","baked":false},{"id":"9ad0ff2c-98bb-4f06-b3f3-85fbd75acfe1","number":"41","volume":null,"title":null,"lang":"en","pages":13,"createdAt":"2021-09-11T12:09:58+00:00","baked":false},{"id":"a7f90c10-5f50-4f91-af2b-9b0c6313aabf","number":"40","volume":null,"title":null,"lang":"en","pages":10,"createdAt":"2021-09-11T12:07:56+00:00","baked":false},{"id":"eb881910-bf57-4fca-9d19-aaa0596775b9","number":"39","volume":null,"title":null,"lang":"en","pages":12,"createdAt":"2021-09-10T03:28:31+00:00","baked":false},{"id":"4bd72190-cd0b-4f40-ba70-9925a2ec7c1d","number":"38","volume":null,"title":null,"lang":"en","pages":12,"createdAt":"2021-09-10T03:27:06+00:00","baked":false},{"id":"f7dd120f-0e6a-4ff0-8d18-56b26f022f7a","number":"37","volume":null,"title":null,"lang":"en","pages":12,"createdAt":"2021-09-05T15:59:40+00:00","baked":false}],"chapterCount":8,"chaptersAt":"2026-10-26T19:06:49.168Z"},"0ee33627-9a1d-454d-bf11-25ee1fa0a136":{"id":"0ee33627-9a1d-454d-bf11-25ee1fa0a136","title":"Yeon Lok Heun","altTitle":"His Majesty's Secret Heroine","description":"Yeon Lokheun is a girl who grows up living as a boy learning martial and spiritual arts. She heads for the palace in order to clear the name of her father, a wanted criminal, where she meets the young Emperor Garyun. He promises to save her father's life in exchange for her lifelong services. After gaining Garyun's trust, she travels the world solving supernatural-like problems that arise in place of the Emperor. But how long can she continue this life without the others finding out that she is actually a woman?\n\n---\nLokheun’s name means \"happy morning,\" but her life takes a tragic turn when her mother is murdered and her father becomes a fugitive after exacting revenge. To save him, Lokheun devotes her life to Garyun, the dashing emperor who’s committed to right the wrongs of his father. Believing Lokheun to be a boy, Garyun is determined to mold her into an unsurpassed martial artist, even if it means sending her to hell. Their strained relationship turns into something more as Lokheun searches for the one thing she’s never had: a life befitting her name.\n\n---\n**Original Webtoon:** [Daum](https://webtoon.kakao.com/content/%EC%97%B0%EB%A1%9D%ED%9D%94/2621), [KakaoPage](https://page.kakao.com/home?seriesId=51793959)\n\n**Official Translations:**\n* [English](https://tapas.io/series/his-majestys-secret-heroine/info)\n* [Japanese / 日本語](https://piccoma.com/web/product/76054)","year":2019,"status":"completed","lastChapter":"205","contentRating":"suggestive","tags":["Action","Romance","Adventure","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/0ee33627-9a1d-454d-bf11-25ee1fa0a136/bd484881-7981-4de0-9ef3-eb8e2e43614b.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["es-la","en","fr","pt-br"],"lane":"manhwa","rating":8.83,"follows":19873,"listAt":"2026-10-27T05:13:55.735Z","chapters":[{"id":"fd7c7dfa-1f8a-4654-9488-452d57cf5e94","number":"139","volume":"4","title":null,"lang":"en","pages":16,"createdAt":"2025-01-03T12:02:42+00:00","baked":false},{"id":"11b986c2-9540-44b8-a292-71ec384d25d2","number":"138","volume":"4","title":null,"lang":"en","pages":15,"createdAt":"2024-10-24T00:56:09+00:00","baked":false},{"id":"e82a8839-771a-4fa6-8f0d-476688426331","number":"137","volume