"en","pages":20,"createdAt":"2026-03-19T00:06:14+00:00","baked":false},{"id":"d9bdea4d-baf4-4685-9592-4a791c6b2d4a","number":"69","volume":"7","title":"What Ever Happened To Tenkai Ruby?","lang":"en","pages":20,"createdAt":"2026-03-15T01:20:33+00:00","baked":false}],"chapterCount":108,"chaptersAt":"2026-10-26T19:09:25.303Z"},"2d1860b5-a3cb-4105-ba77-aad30cbe51a6":{"id":"2d1860b5-a3cb-4105-ba77-aad30cbe51a6","title":"Bangeo neun Sarang eul Sidgo","altTitle":"Defense Carries Love","description":"All Chulyong ever wanted was to sing. But dreams don’t pay rent, and now he’s stuck working part-time at a fish market, wondering when it all slipped through his fingers. One delivery gone wrong - a house, a famous composer, a bad first impression. Ruth touches him like he’s an instrument, and Chulyong, who’s had enough of life playing him, hits back - literally. A trophy to the head. A threat of a lawsuit. Words sharper than knives. Somewhere in the middle of the wreckage: a song that could change everything. Enemies. Rivals. Maybe something more. Defense carries more than just fish — it carries hope. It carries love.","year":2024,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Romance","Boys' Love","Drama"],"poster":"https://uploads.mangadex.org/covers/2d1860b5-a3cb-4105-ba77-aad30cbe51a6/bcbc8d30-c139-48b7-90b5-60dbc76e3ef0.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["en"],"lane":"manhwa","rating":7.5,"follows":122,"listAt":"2026-10-30T13:05:06.830Z","chapters":[{"id":"0470ebb9-81ef-4e4e-b4d9-db42586bd0c7","number":"2","volume":null,"title":null,"lang":"en","pages":38,"createdAt":"2025-06-13T15:12:39+00:00","baked":false},{"id":"d6931d62-d626-499e-8919-cd62b3c1a0b6","number":"1","volume":null,"title":null,"lang":"en","pages":58,"createdAt":"2025-06-13T14:58:08+00:00","baked":false}],"chapterCount":2,"chaptersAt":"2026-10-26T19:10:54.114Z"},"e9d69f82-4c53-44ce-a94b-32303d172227":{"id":"e9d69f82-4c53-44ce-a94b-32303d172227","title":"Ore Seijo: Ore ga Seijo de Omae Akuyaku Reijou—Saikyou Tag Otome Game Kanzen Kouryaku Itashimasu wa","altTitle":"A Saintess and a Villainess Team Up to Conquer an Otome Game!","description":"Saintess Militia regained her memories on a trip to the ladies' room! \nMy name is Tosaka Kakeru—a high school boy, and, more importantly, I no longer have a certain vital something between my legs!! I had been reincarnated into the world of an otome game!!! What's more, my best friend Mori Fuuma, who had been hit by the same truck as me, had been reborn as Bellrose, a villainess practically drowning in death flags!!!! A Saintess-and-Villainess tag team (with two high school boys inside) sets out to completely conquer the game while romancing a cast of handsome men, and aiming for the one ending where they both survive!","year":2026,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Romance","Comedy","Adventure","Isekai","Fantasy"],"poster":"https://uploads.mangadex.org/covers/e9d69f82-4c53-44ce-a94b-32303d172227/6fc27968-9405-443d-9e2c-a094c06324cd.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["vi","es-la","en"],"lane":"manga","rating":8.5,"follows":16079,"listAt":"2026-10-29T05:55:12.074Z","chapters":[{"id":"7676f896-0a8d-4c5b-a462-073967dd6fb6","number":"3","volume":null,"title":"The Ice Prince Is Dead!","lang":"en","pages":31,"createdAt":"2026-09-06T14:57:38+00:00","baked":false},{"id":"4ee57741-8c1c-4e53-8f13-83f6ff1d08ea","number":"2","volume":null,"title":"I Shall Conquer the Ice Prince!","lang":"en","pages":43,"createdAt":"2026-08-13T23:42:53+00:00","baked":false},{"id":"ace639b6-b169-449e-b263-831cf8d9b40c","number":"1","volume":null,"title":"I’m a Guy, but I Reincarnated into an Otome Game!","lang":"en","pages":52,"createdAt":"2026-08-01T13:12:11+00:00","baked":false},{"id":"f5072e4b-9cee-4b36-9060-2f5af511587d","number":"1","volume":null,"title":"I've Been Reincarnated Into an Otome Game Even though I’m a Guy!","lang":"en","pages":55,"created