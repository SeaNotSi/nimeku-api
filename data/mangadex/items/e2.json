","baked":false},{"id":"e331568b-99aa-4b34-af23-f0e072279905","number":"16","volume":null,"title":null,"lang":"en","pages":7,"createdAt":"2023-08-19T14:44:19+00:00","baked":false},{"id":"20afecf5-f45b-4115-bdd6-b290570950e3","number":"15","volume":null,"title":null,"lang":"en","pages":6,"createdAt":"2023-08-07T11:48:38+00:00","baked":false},{"id":"3b2d9151-68d1-439a-98a6-1d3811935f27","number":"14.5","volume":null,"title":null,"lang":"en","pages":1,"createdAt":"2023-08-06T00:25:01+00:00","baked":false}],"chapterCount":91,"chaptersAt":"2026-10-19T10:28:29.672Z"},"001a5a4e-ea37-4ef5-9643-43a0374b58be":{"id":"001a5a4e-ea37-4ef5-9643-43a0374b58be","title":"Eomma ga Jungneun Ending eun Sajeorimnida!","altTitle":"I Refuse an Ending Where My Mother Dies!","description":"The moment I blew out the candles on my 7th birthday cake—\n\nI realized I had reincarnated into the world of a novel. And not just as anyone, but as the daughter of the main characters! The problem is…\n\n[The heroine ■ □ dies, and the male leads… cause the world to end?]\n\nSo, in the side stories, my mother dies and my fathers cause the apocalypse? Is this for real…?\n\n‘No way. I’ll stop it no matter what!’\n\nI’m a brave seven-year-old now! So, I set out to lead my fathers and twist the original story by any means possible.\n\n“You know what? You and I are destined to fall in love someday.”\n\nI’m busy enough trying to save my mother, so who the heck are you?\n\nAfter successfully twisting the original plot, I was planning to finally enjoy my youth, but —\n\n“A son-in-law? Sure. I’ll accept anyone, as long as they meet one condition.”\n“What condition?”\n“They have to fight us and win.”\n“Whatever the reason, any guy who lays a hand on my daughter is as good as dead.”\n\nIt seems my fathers have no intention of living peacefully.\n\n“That’s easy. Just tell them to come at me all at once.”\n\nWhy are you agreeing to that so casually?!","year":2025,"status":"completed","lastChapter":null,"contentRating":"safe","tags":["Historical","Romance","Comedy","Isekai","Fantasy"],"poster":"https://uploads.mangadex.org/covers/001a5a4e-ea37-4ef5-9643-43a0374b58be/6a4fbf29-b8f3-4b6b-9972-c244ab36753c.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["en","fr"],"lane":"manhwa","rating":6.82,"follows":746,"listAt":"2026-10-24T18:51:14.003Z","chapters":[{"id":"4bca54a9-baeb-4a54-ba12-9c469589b3eb","number":null,"volume":null,"title":null,"lang":"en","pages":13,"createdAt":"2025-08-17T09:57:06+00:00","baked":false},{"id":"c2150e96-2692-42f6-b7da-357c99728fe7","number":null,"volume":null,"title":null,"lang":"en","pages":38,"createdAt":"2026-06-28T15:47:42+00:00","baked":false}],"chapterCount":2,"chaptersAt":"2026-10-19T10:31:22.708Z"},"dd6bb34f-a78a-48c4-9b1e-fff81cc5967c":{"id":"dd6bb34f-a78a-48c4-9b1e-fff81cc5967c","title":"Backbone","altTitle":"BackBone","description":"Magic only happens once in a lifetime. An action fantasy comic set in the unknown land of 'Backbone' in search of a prince kidnapped by an unidentified trio.","year":2009,"status":"completed","lastChapter":null,"contentRating":"safe","tags":["Action","Adventure","Fantasy"],"poster":"https://uploads.mangadex.org/covers/dd6bb34f-a78a-48c4-9b1e-fff81cc5967c/c20affef-9404-499e-8624-4770513c0809.png.512.jpg","originalLanguage":"ko","availableLanguages":["en"],"lane":"manhwa","rating":8.33,"follows":166,"listAt":"2026-10-24T18:51:37.019Z","chapters":[{"id":"a0a789a3-d949-4790-a3b8-c1ab3563898c","number":"1","volume":"1","title":null,"lang":"en","pages":30,"createdAt":"2025-06-16T07:16:45+00:00","baked":false}],"chapterCount":1,"chaptersAt":"2026-10-19T10:32:19.548Z"},"99638ee0-6116-4587-8de9-56ac8ee23947":{"id":"99638ee0-6116-4587-8de9-56ac8ee23947","title":"Danshi Koukousei wa Isekai de JK ni Natta.","altTitle":"My Second Life is as the Strongest High School Girl in Another World","description":"A serious and uptight male high school student becomes a girl in another world...!? Cattleya Lanoquid is a girl from another world who longs for magic. On her 16th birthday, her mother tells her that the way to save their household finances is to... get excited...!? However, Cattleya was actually Ranka Harumigawa, a neat and serious male high school student in his past life!! Ranka (Cattleya) wants to become a respectable adult, but is torn between that desire and his hidden desires...!!","year":2023,"status":"completed","lastChapter":"24","contentRating":"suggestive","tags":["Romance","Adventure","Isekai","Fantasy"],"poster":"https://uploads.mangadex.org/covers/99638ee0-6116-4587-8de9-56ac8ee23947/f02d5d15-f769-42f8-8a56-b41d60fa6daa.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["zh","en","id","es-la"],"lane":"manga","rating":7.91,"follows":7843,"listAt":"2026-10-24T18:50:59.605Z","chapters":[{"id":"8680e05c-7723-400a-ba10-fef16f79ba20","number":"12","volume":"1","title":null,"lang":"id","pages":26,"createdAt":"2024-09-08T17:26:39+00:00","baked":false},{"id":"baa47894-2fb4-426a-8c74-ece3d1b5f577","number":"11","volume":"1","title":null,"lang":"id","pages":24,"createdAt":"2024-04-03T14:01:32+00:00","baked":false},{"id":"393a4659-3f0d-44c7-8931-b30ff3f2375f","number":"10","volume":"1","title":null,"lang":"id","pages":23,"createdAt":"2024-02-21T12:13:49+00:00","baked":false},{"id":"66577d21-94d4-46ad-bc6f-79c32c0f8875","number":"9","volume":"1","title":null,"lang":"id","pages":25,"createdAt":"2024-01-31T08:01:53+00:00","baked":false},{"id":"c8fd69c0-3cad-4de7-873b-5de4d825250b","number":"8","volume":"1","title":null,"lang":"id","pages":24,"createdAt":"2024-01-12T00:47:42+00:00","baked":false},{"id":"b27e41ba-9aae-4df2-8b30-bb5269eb9766","number":"7","volume":"1","title":null,"lang":"id","pages":21,"createdAt":"2023-12-24T00:07:55+00:00","baked":false},{"id":"815eacfb-2084-4332-86d6-2e155d6de527","number":"7","volume":"1","title":null,"lang":"en","pages":20,"createdAt":"2026-01-24T23:00:50+00:00","baked":false},{"id":"8aa6e979-c87d-4974-9585-b5740fac1e35","number":"6","vo