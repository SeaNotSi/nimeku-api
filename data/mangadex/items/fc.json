{"1f40b922-6abb-418e-a7e9-cc4d25b21439":{"id":"1f40b922-6abb-418e-a7e9-cc4d25b21439","title":"Saihate no Paladin","altTitle":"The Faraway Paladin","description":"A man dies alone after living a stagnant and fruitless life — but that's not where his story ends, as a boy named William is born into a land of fantasy and magic.\n\nRaised in a city of the dead by his new family — a mummy, a skeleton, and a ghost — he can remember glimpses of his past life, enough to know his time on Earth was wasted, and he vows not to let that happen again. Schooled in magic and combat, Will sets out on a journey to see the world. Along the way, he'll meet beings of all shapes and sizes. Each of these people has a story to tell and a lesson to teach Will about how to live his life to the fullest.\n___\n**Character Designer:** [Rin Kususaga](https://mangadex.org/author/32478bd0-f73b-4572-b8f6-f0cf5fa6a825)","year":2017,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Action","Adventure","Isekai","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/1f40b922-6abb-418e-a7e9-cc4d25b21439/c2101924-bc88-48b0-b3ad-681dff99663e.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["en","es-la","ru","pt-br","id","tr"],"lane":"manga","rating":9.3,"follows":100567,"listAt":"2026-10-19T10:05:14.358Z","chapters":[{"id":"2dfd0c74-f88d-4157-a5d5-456113211c5b","number":"68.3","volume":null,"title":null,"lang":"en","pages":14,"createdAt":"2025-05-09T05:27:06+00:00","baked":true},{"id":"e59c1f67-23e5-4eb8-8408-f2f98d8e0044","number":"68.2","volume":null,"title":null,"lang":"en","pages":16,"createdAt":"2025-03-20T04:58:03+00:00","baked":true},{"id":"7dc9f29b-5c3b-4d66-82da-55af08adbb73","number":"68.1","volume":null,"title":null,"lang":"en","pages":15,"createdAt":"2025-02-16T06:53:47+00:00","baked":true},{"id":"7992c1b2-83ee-44a3-9cdd-7bf3d7761177","number":"67.3","volume":null,"title":null,"lang":"en","pages":13,"createdAt":"2025-01-18T17:22:23+00:00","baked":true},{"