{"25c7badb-1c8c-4b96-a7dc-cb55f2ad86e4":{"id":"25c7badb-1c8c-4b96-a7dc-cb55f2ad86e4","title":"Just Leave Me Be","altTitle":"Please Leave Me Behind","description":"Adele was a hapless orphan until a duke gave her a choice: live as a substitute for his dead daughter, or die on the streets. Despite playing this role to the best of her ability, an order for her assassination was given shortly after he married her off. Miraculously, she is sent back in time and decides to make up for the years wasted living a lie. As ancient ruins call to her, can she use her past knowledge and unexpected help from the Black Knight to defeat the dangers ahead and change fate?\n\n\n\n---\n\n**Links:**  \n- [Promotional Video](https://youtu.be/klyrIC4ORo4)  \n- [Official Indonesian Translation](https://kakaopage.co.id/content/Campakkan-Aku/3359)  \n- [Official Japanese Translation](https://piccoma.com/web/product/33704)","year":2020,"status":"completed","lastChapter":"126","contentRating":"safe","tags":["Romance","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/25c7badb-1c8c-4b96-a7dc-cb55f2ad86e4/07bc97b8-12f6-4171-ab59-eafc25b46e80.jpg.512.jpg","originalLanguage":"ko","availableLanguages":["en","ru","id","fr"],"lane":"manhwa","rating":8.59,"follows":43272,"listAt":"2026-10-19T10:05:22.887Z","chapters":[{"id":"e258a2f0-450e-4fd0-a923-17acb846799a","number":"58","volume":"2","title":null,"lang":"en","pages":9,"createdAt":"2021-07-29T09:00:34+00:00","baked":false},{"id":"58fd226e-d02c-4f1b-b334-bdf32ee1a101","number":"57","volume":"2","title":null,"lang":"en","pages":9,"createdAt":"2021-07-28T05:31:43+00:00","baked":false},{"id":"d6533b17-131c-4fac-937b-1e0625a1ae12","number":"56","volume":"2","title":null,"lang":"en","pages":11,"createdAt":"2021-07-28T05:30:13+00:00","baked":false}],"chapterCount":3,"chaptersAt":"2026-10-19T10:27:37.410Z"},"f1522b1b-4b5a-4c09-bb39-8b092f4b7edd":{"id":"f1522b1b-4b5a-4c09-bb39-8b092f4b7edd","title":"Shoukan Sareta Kenja wa Isekai wo Yuku ~Sai