{"d0c60a11-0106-45cf-abfc-d131cb49868f":{"id":"d0c60a11-0106-45cf-abfc-d131cb49868f","title":"Yuusha Party wo Tsuihou sareta Beast Tamer, Saikyoushu no Nekomimi Shoujo to Deau","altTitle":"Beast Tamer","description":"Because Rein was a weak and simple beast tamer, he was expelled from the hero's group but that didn't stop his desire to be an adventurer. By taking simple quests afterwards he has a destined encounter with a strong cat girl.","year":2019,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Action","Romance","Comedy","Adventure","Fantasy","Slice of Life"],"poster":"https://uploads.mangadex.org/covers/d0c60a11-0106-45cf-abfc-d131cb49868f/73f2de68-7fa2-4e0a-aed3-3f7577cbd59e.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["en","fr","pt-br","vi","es-la","id"],"lane":"manga","rating":7.67,"follows":70757,"listAt":"2026-10-25T12:57:16.517Z","chapters":[{"id":"8fcfd5e0-6d08-484d-b3b7-8f13f7d5659b","number":"103","volume":null,"title":"An Unexpected Event ","lang":"en","pages":11,"createdAt":"2026-08-22T00:55:40+00:00","baked":false},{"id":"5c9d25b2-19c3-4305-9e87-34a83ed858ee","number":"102","volume":null,"title":"Bath time order","lang":"en","pages":9,"createdAt":"2026-08-15T19:43:29+00:00","baked":false},{"id":"2f67bb33-a97a-4671-8ffb-514a10913d84","number":"101","volume":null,"title":"Luna’s cooking class","lang":"en","pages":17,"createdAt":"2026-08-15T13:22:18+00:00","baked":false},{"id":"ab0d590a-d884-497e-b0c3-8016c66ff1a8","number":"94","volume":"11","title":"March of Outrage","lang":"en","pages":14,"createdAt":"2026-08-19T18:18:54+00:00","baked":false},{"id":"8d96b564-da71-4802-a37d-ba345a3062d3","number":"93.2","volume":"11","title":"For My Comrades","lang":"en","pages":12,"createdAt":"2026-08-17T15:31:46+00:00","baked":false},{"id":"029dce9d-e423-4680-980d-42a40ab43983","number":"93.1","volume":"11","title":"For My Comrades","lang":"en","pages":10,"createdAt":"2025-10-05T02:29:41+00:00","baked":false},{"id":"b0bba35c-e193