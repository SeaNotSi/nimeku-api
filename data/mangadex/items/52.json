ke!\"\n\nA heart-pounding story about an ultra-popular hero and an unpopular magical girl who accepts his confession!","year":2023,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Romance","Superhero","Magical Girls","Drama","Fantasy"],"poster":"https://uploads.mangadex.org/covers/253150fe-669e-4c5f-b340-aac2a7b1831c/32ead13a-208e-4e86-b032-59e448abafaa.png.512.jpg","originalLanguage":"ko","availableLanguages":["en"],"lane":"manhwa","rating":8.67,"follows":3498,"listAt":"2026-10-24T07:00:42.441Z","chapters":[{"id":"f410fb39-1e11-4cb6-8902-13d8694393ee","number":"16","volume":null,"title":null,"lang":"en","pages":39,"createdAt":"2026-08-02T17:56:11+00:00","baked":false},{"id":"ac966ea1-3c45-426c-a835-f8ba20397485","number":"15","volume":null,"title":null,"lang":"en","pages":39,"createdAt":"2026-08-02T17:52:45+00:00","baked":false},{"id":"400cb58e-93bd-4c5e-88f7-474a60959002","number":"14","volume":null,"title":null,"lang":"en","pages":48,"createdAt":"2026-07-14T18:07:30+00:00","baked":false},{"id":"89d7a833-0a18-4899-8e27-eb0350916e2b","number":"13","volume":null,"title":null,"lang":"en","pages":40,"createdAt":"2026-07-14T17:29:03+00:00","baked":false},{"id":"f60f4842-1493-445c-bd98-f159c8a85e0d","number":"12","volume":null,"title":null,"lang":"en","pages":41,"createdAt":"2026-06-19T07:20:19+00:00","baked":false},{"id":"4ece1676-59b2-44d3-8964-2ad40985cdee","number":"11","volume":null,"title":null,"lang":"en","pages":42,"createdAt":"2026-06-18T05:55:43+00:00","baked":false},{"id":"730ccef2-ee1b-46f6-859e-fda958e0bd33","number":"10","volume":null,"title":null,"lang":"en","pages":44,"createdAt":"2026-06-16T18:52:30+00:00","baked":false},{"id":"6e5b8009-3bfb-4108-a408-898dce23425d","number":"9","volume":null,"title":null,"lang":"en","pages":35,"createdAt":"2026-06-16T17:51:08+00:00","baked":false},{"id":"78560c51-a117-4a05-b18d-7ac7bd4f91cf","number":"8","volume":null,"title":null,"lang":"en","pages":57,"createdAt":"2025-11-26T14:26:34+00:00","baked