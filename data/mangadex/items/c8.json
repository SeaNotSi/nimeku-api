{"5272da37-6c69-4ecc-a1e0-d25db7b3e80f":{"id":"5272da37-6c69-4ecc-a1e0-d25db7b3e80f","title":"Shujinkou no Osananajimi ga, Wakiyaku no Ore ni Guigui Kuru","altTitle":"The Protagonist's Childhood Friend Is Coming on Strong to Me, a Mob","description":"Ishii Kazuki’s life is destroyed after he becomes entangled in the romantic troubles of his friend Amada Teruhito, a boy who is absurdly popular like a romcom protagonist. The situation eventually drives Kazuki to take his own life. However, a miracle occurs, and he finds himself back at the morning of his high school entrance ceremony. In this second life, Kazuki decides to stay inconspicuous, avoid making friends, and live quietly. Yet for some reason, Amada’s childhood friend, the cool beauty called the “Ice Empress,” Hidaka Mikoto, starts approaching him.","year":2026,"status":"ongoing","lastChapter":null,"contentRating":"safe","tags":["Romance","Drama"],"poster":"https://uploads.mangadex.org/covers/5272da37-6c69-4ecc-a1e0-d25db7b3e80f/3ef08942-c50b-4dc8-bda3-c22259e57dc7.jpg.512.jpg","originalLanguage":"ja","availableLanguages":["es-la","en","vi","pt-br","id"],"lane":"manga","rating":8.85,"follows":66887,"listAt":"2026-10-19T10:05:21.695Z","chapters":[{"id":"78a5c4a3-7a70-4dea-874f-096368d41414","number":"4","volume":null,"title":"Bab 4","lang":"id","pages":21,"createdAt":"2026-09-28T06:32:15+00:00","baked":false},{"id":"d6256afd-5419-4e1d-9037-94994c3691ca","number":"4","volume":null,"title":null,"lang":"en","pages":22,"createdAt":"2026-09-28T15:46:42+00:00","baked":false},{"id":"fc231b0b-482c-45cf-95ab-c815b2fb6ea0","number":"4","volume":null,"title":"Bekal penuh cinta","lang":"id","pages":24,"createdAt":"2026-09-28T18:19:01+00:00","baked":false},{"id":"850a1986-87b2-46c0-91a2-7ca240c18c54","number":"3","volume":null,"title":null,"lang":"id","pages":28,"createdAt":"2026-08-27T15:11:09+00:00","baked":false},{"id":"9ea47c7d-ab1c-4183-8b53-b8d0a75e9920","number":"3","volume":null,"title":null,"lang":"en","pages":26,