57:30+00:00","baked":false},{"id":"ba1ba1d9-5863-4c17-a443-3bdb3a75399b","number":"6","volume":"1","title":null,"lang":"en","pages":23,"createdAt":"2022-07-25T15:29:12+00:00","baked":false},{"id":"98a800cd-2a81-4126-bdcd-41e7468d8ce9","number":"5","volume":"1","title":null,"lang":"en","pages":25,"createdAt":"2022-05-10T11:57:40+00:00","baked":false},{"id":"d0a63b8a-1455-4315-850e-54a0fcb6a48b","number":"4","volume":"1","title":null,"lang":"en","pages":25,"createdAt":"2022-04-02T00:59:06+00:00","baked":false},{"id":"53b6c540-eb5c-4466-9a1e-7f1b988c186e","number":"3","volume":"1","title":null,"lang":"en","pages":28,"createdAt":"2022-03-28T02:47:42+00:00","baked":false},{"id":"7c015178-b381-4d9e-80d7-62b3aa4dd67d","number":"2","volume":"1","title":null,"lang":"en","pages":24,"createdAt":"2022-03-25T02:17:02+00:00","baked":false},{"id":"f9040778-9659-4c98-bff7-11b0c96a5c1f","number":"1","volume":"1","title":null,"lang":"en","pages":26,"createdAt":"2022-03-23T10:16:50+00:00","baked":false}],"chapterCount":29,"chaptersAt":"2026-10-19T10:28:13.923Z"},"c5026183-3124-4d46-8fc9-bf78995cb47e":{"id":"c5026183-3124-4d46-8fc9-bf78995cb47e","title":"I Ran Away and Got Married","altTitle":"逃げた先には結婚が待っていました","description":"“You’re mine.”\n\nWhen Raphia met her demise after having been used and thrown away by her benefactor, Yuri, she went back nine years in the past.\n\n‘I’m not going to relive that hell!’\n\nRunning away from her benefactor, she went to Kasein Soleia, Yuri’s archnemesis, and signed a new sponsorship contract with him.\n\n“I shall kill every single person you despise, Milord.”\n\n“The necessary role happens to be open, and you might just be the right person for it.”\n\nYoung Duke. This is a sponsorship contract, right? But why . . . why are we getting married?\n\n===\n\n“Throughout the time I won’t be by your side . . . I will think of nothing but your small, cute head.”\n\nThat low voice sent shivers down her spine.\n\n“I can’t believe you’re leaving. I’ll just . . .”\n\nKasein looked at her sharply as if he was daring her to continue making up excuses.\n\n“You have to answer well, brat. Depending on what you say, all the wagon and shoe craftsmen of the Empire might lose their livelihood.”\n\nDespite his harsh words, Kasein’s touch was gentle. He couldn’t take his eyes off of Raphia, who strangely grew more beautiful by the day.\n\n---\n**Original Webtoon:** [Daum](https://webtoon.kakao.com/content/%EB%8F%84%EB%A7%9D%EC%B3%A4%EB%8D%94%EB%8B%88-%EA%B2%B0%ED%98%BC%EC%9D%84-%ED%95%98%EA%B2%8C-%EB%90%90%EC%8A%B5%EB%8B%88%EB%8B%A4/3299), [KakaoPage](https://page.kakao.com/content/61190666)","year":2023,"status":"completed","lastChapter":"71","contentRating":"safe","tags":["Romance","Fantasy"],"poster":"https://uploads.mangadex.org/covers/c5026183-3124-4d46-8fc9-bf78995cb47e/2eb4768d-eafe-49df-9f1c-7a3382f73b9f.png.512.jpg","originalLanguage":"ko","availableLanguages":["fr","en"],"lane":"manhwa","rating":7.45,"follows":1363,"listAt":"2026-10-25T00:58:31.371Z","chapters":[{"id":"223f194e-4c8c-4c17-915d-23529edcb484","number":"27","volume":null,"title":null,"lang":"en","pages":20,"createdAt":"2025-05-03T00:50:04+00:00","baked":false},{"id":"5f101ecd-8263-4378-a0be-f943f0460060","number":"26","volume":null,"title":null,"lang":"en","pages":18,"createdAt":"2025-04-27T12:20:21+00:00","baked":false},{"id":"b1df3ea3-79f0-482b-b19c-030232579ef7","number":"25","volume":null,"title":null,"lang":"en","pages":18,"createdAt":"2025-04-01T03:17:16+00:00","baked":false},{"id":"67c1b82a-5cef-4887-b1ba-bb3b0d3f17a8","number":"24","volume":null,"title":null,"lang":"en","pages":20,"createdAt":"2025-03-31T09:26:55+00:00","baked":false},{"id":"e8353487-3b54-477d-b90a-ee02d87cccfb","number":"23","volume":null,"title":null,"lang":"en","pages":20,"createdAt":"2025-03-30T03:56:48+00:00","baked":false},{"id":"7b2bdb2b-0e2c-4b6d-baa2-f06f3fe171bc","number":"22","volume":null,"title":null,"lang":"en","pages":20,"createdAt":"2025-03-29T02:24:12+00:00","baked":fa